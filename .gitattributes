# Pinned/generated conformance corpus + schema MUST be LF so the SHA-256 pinned in
# PIN.json / MANIFEST.sha256 matches on every platform. (Windows Python writes CRLF; git
# commits LF; a CRLF-based pin drifts the pinned-vector gate in CI.)
test-vectors/v1/conformance-corpus.json text eol=lf
test-vectors/schemas/conformance-corpus.schema.json text eol=lf
harness/runner/corpus/conformance-corpus.json text eol=lf

# Conformance KAT vectors + schemas are hash-pinned by the tests; force LF so a Windows
# checkout does not fail the SHA-256 integrity assertion (audit finding N2).
test-vectors/** text eol=lf

# Hash-pinned per-channel frame-type registry + its schema (MANIFEST.sha256) — force LF
# so the pinned SHA-256 matches on every platform (Windows autocrlf would otherwise drift it).
registries/frame_types_channel.csv text eol=lf
registries/schemas/frame_types_channel.schema.json text eol=lf

# T18.2 state-machine conformance gate (durable). The learned models + the draft-derived
# state table are hash-pinned in MANIFEST.sha256; the provenance manifest + diff report are
# generated by Windows Python (which writes CRLF in text mode). Force LF for all of them so
# the pinned SHA-256 matches on every platform and a local run does not churn CRLF.
harness/statelearn/learned-initiator.json text eol=lf
harness/statelearn/learned-responder.json text eol=lf
harness/statelearn/statelearn-provenance.json text eol=lf
harness/statelearn/diff-report.json text eol=lf
harness/statelearn/learn-config.json text eol=lf
harness/statemodel/npamp-state-table.json text eol=lf

# F1: the REMAINING hash-pinned text classes in MANIFEST.sha256 — the IETF draft, the
# spec prose (incl. per-channel docs), every registry CSV + its JSON schema, and the CDDL
# wire schema — are all committed LF and SHA-256-pinned. Force LF on checkout so a Windows
# `core.autocrlf=true` working tree matches the pin (verify-pins) on every platform.
# Scoped by extension so no binary asset under these dirs can ever be line-ending-mangled.
ietf/*.md text eol=lf
spec/**/*.md text eol=lf
registries/**/*.csv text eol=lf
registries/**/*.json text eol=lf
schema/**/*.cddl text eol=lf
schema/**/*.json text eol=lf
